{
  "schemaVersion": 1,
  "id": "flintclient",
  "version": "${version}",
  "name": "Flint Client",
  "description": "Flint Client's in-game runtime: the Flint main menu. Fast where it matters.",
  "authors": [
    "Flint Client Team"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "com.flintclient.client.FlintPreLaunch"
    ],
    "client": [
      "com.flintclient.client.FlintClient"
    ],
    "voicechat": [
      "com.flintclient.client.control.platform.sound.VoiceChatPlugin"
    ]
  },
  "mixins": [
    {
      "config": "flintclient.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "flintclient.version.mixins.json",
      "environment": "client"
    },
    {
      "config": "flintclient.thirdparty.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "flintclient:builtFor": "${builtFor}"
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraftRange}",
    "java": ">=25"
  }
}
