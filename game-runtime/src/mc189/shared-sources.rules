# Minecraft 1.8.9 (game-runtime/legacy189, see build-logic/SharedSources): the shared sources that never touch Minecraft,
# compiled unchanged into the 1.8.9 runtime (docs/LEGACY189_SHARED_MENU_PLAN.md). 1.8.9 is a different engine (Feather
# names, LWJGL 2, fixed-function GL), so it takes no Minecraft-facing shared file; its own code (../legacy189/src) is the
# 1.8.9 backend of the shared model.
#
# These files must stay platform-free: no net.minecraft, com.mojang, org.joml or org.lwjgl, and no shared class outside
# this list (or the platform classes 1.8.9 has its own copies of, src/mc189/java/.../platform). PlatformFreeSourcesTest
# (src/test, run by the 26.x and 1.21.x builds) reads this file and fails the build otherwise.

# Flint's log, without the 26.x entry point.
include FlintLog.java
# Start-up timings for the log (ControlState times its steps with it).
include StartupTrace.java
# Loads the Right Shift menu's classes ahead on a worker (ModMenuScreen.warmUp).
include ClassWarmer.java
# Packs and worlds dropped into the game's folders in a form it can't read (.rar, a pack a folder down), made readable.
include files/**
# The saved settings and layouts every screen reads (the same files on every line).
include control/ControlState.java
# The player's theme from the Flint app (and back), which the palette's accent follows.
include control/ThemeSync.java

# The mod model: descriptors, settings, registry, migrations.
include control/model/**
# The stores: control-center.json, layouts, share codes.
include control/store/**
# HUD placement: anchors, placements, snapping, undo (not control/hud/render: it draws).
include control/hud/*.java
# The mods' shared logic (zoom, toggles, combat, waypoints...).
include control/feature/**
# The game link to the Flint app (Gson and a loopback socket): Music Player asks it what's playing.
include module/account/LauncherLink.java
# Friends and the Flint Store through the same link (the Friends and Cosmetics windows), and the credential guard.
include module/social/**
# The count of what Flint keeps on the GPU (the mask atlas reports its textures).
include graphics/GpuResourceTracker.java
# The canvas: shapes, text, the mask atlas, icons, card pictures (FontPreload prepares 26.x's TrueType fonts).
include render/**
skip render/FontPreload.java
# The kit: nodes, controls, focus, scrolling, the kit screen.
include ui/kit/**
include ui/Motion.java
include ui/FlintFrame.java
# The Right Shift menu, as on every line.
include control/rshift/**
# Screens and panels of mods 1.8.9 doesn't have (Advancements, Keybind Search, Pack Organizer, Tier Tagger).
skip control/rshift/AdvancementsListScreen.java
skip control/rshift/KeybindSearchScreen.java
skip control/rshift/PacksPanel.java
skip control/rshift/TierTaggerPanel.java
# The HUD, as on every line: its views and renderer, the HUD editor and the HUD page on it (src/mc189/java/.../platform has
# 1.8.9's HudData, HudEffects, ItemPainter and HudMaps), the guard a failing path turns itself off with, and the frame times
# FPS reads.
include control/hud/render/**
include control/editor/**
include control/platform/HookGuard.java
include perf/FrameStats.java
# Smooth screen sharing (the game's GPU priority), with its Windows calls (JNA, which 1.8.9 ships too).
include perf/GpuPriority.java
include perf/WinNative.java
# Motion Blur's rules (its two modes, Smooth's trail, the scene resets; Natural Motion Blur's timing, passes and samples), the same
# on every line: legacy/mods/MotionBlur draws them. ShaderPacks asks Iris by reflection (1.8.9 has none) for the page's note.
include control/fx/BlurRules.java
include control/fx/NmbTiming.java
include control/fx/ShaderPacks.java

# Gson: Minecraft 1.8.9 ships Gson 2.2.4; the shared code is written against a modern Gson (26.3's), built into the 1.8.9 jar
# under Flint's own package (legacy189/build.gradle relocateGson) so it never meets Minecraft's.
replace com.google.gson. com.flintclient.shaded.gson.

# Instant Swap's engine on 1.8.9 is its own (legacy/swap/SwapEngine189: LWJGL 2's window, 1.8.9's world and server joins).
s-in module/social/InstantSwap.java "com\.flintclient\.client\.control\.platform\.Mc263SwapEngine" => "com.flintclient.legacy.swap.SwapEngine189"
# The hot loader's rule (which mods go into the running game with no restart): pure. 1.8.9's loader is legacy/swap/HotLoader189.
include hotload/HotLoadRule.java
# The 3D cosmetics' shared model (Bedrock geometry and animation, Molang, the loading service, emote poses, thumbnails): pure.
# 1.8.9 draws them itself (legacy/cosmetics).
include cosmetics/**

# Logging: 1.8.9 has log4j 2.0 and no slf4j. log4j's Logger takes the same {} placeholders and trailing exception.
replace org.slf4j.LoggerFactory org.apache.logging.log4j.LogManager
replace org.slf4j.Logger org.apache.logging.log4j.Logger
word LoggerFactory LogManager

# ---------- Flint's main menu (the title screen, its parts and its pages): the same code as on every line ----------
# Flint's main menu, its controls and its pages are written against newer Minecraft's GUI (its Screen, widgets, Component,
# key and mouse events). 1.8.9 compiles them unchanged: "adapt" keeps a file that is NOT platform-free (PlatformFreeSourcesTest
# checks the includes only), and the rules below point the 26.x GUI types it names at stand-ins of the same names
# (src/mc189/java/com/flintclient/client/mc) that do the same on 1.8.9. A file here that starts to name a newer Minecraft type
# no stand-in has fails this build: add the stand-in (or a 1.8.9 overlay file of the same path for what differs).
# What differs on 1.8.9 has an overlay file of its own: the artwork (ui/Backdrop), the blend with 1.8.9's own title screen and
# the switch and cards on it (ui/screen/MenuBlend, VanillaTitleExtras), the demo world, multiplayer access, the account
# switch and faces (module/account/SessionSwitch, AccountSkin), the server pings (module/servers/ServerShortcuts), the menu
# key (control/ControlCenter), the log and versions (FlintClient, FlintPreLaunch, util/FlintInfo).
adapt ui/screen/FlintTitleScreen.java
adapt ui/screen/MenuLayout.java
adapt ui/screen/MenuGeometry.java
adapt ui/screen/WhatsNewScreen.java
adapt ui/screen/MenuSizesScreen.java
adapt ui/screen/UtilitiesScreen.java
adapt ui/screen/FlintCreditsScreen.java
adapt ui/screen/FlintPageScreen.java
adapt ui/screen/ScreenshotsScreen.java
adapt ui/widget/*.java
skip ui/widget/SpriteButton.java
adapt ui/MenuScale.java
adapt ui/FlintTooltip.java
adapt ui/UiFit.java
adapt module/account/AccountSwitcher.java
adapt module/news/WhatsNew.java
adapt module/servers/QuickPlay.java
adapt module/screenshots/*.java
adapt config/FlintConfig.java
adapt util/FlintCredits.java
# Newer Minecraft's types, imported or written out, become the stand-ins of the same simple name.
s-in {ui/screen/*.java,ui/widget/*.java,ui/MenuScale.java,ui/FlintTooltip.java,module/account/AccountSwitcher.java,module/screenshots/*.java} (?m)^import (?:net\.minecraft|com\.mojang)(?:\.\w+)*\.(\w+); => import com.flintclient.client.mc.$1;
s-in {ui/screen/*.java,ui/widget/*.java,ui/MenuScale.java,module/account/AccountSwitcher.java} \b(?:net\.minecraft|com\.mojang)(?:\.[a-z][a-z0-9_]*)+\.(?=[A-Z]) => com.flintclient.client.mc.
# fastutil isn't in 1.8.9: the screenshot list's int map is a plain map.
s-in module/screenshots/Thumbnails.java import it\.unimi\.dsi\.fastutil\.ints\.Int2ObjectOpenHashMap; => import com.flintclient.client.mc.Int2ObjectOpenHashMap;
# 1.8.9's Screen.init() is public (newer Minecraft's is protected).
s-in {ui/screen/FlintTitleScreen.java,ui/screen/FlintPageScreen.java,ui/screen/MenuSizesScreen.java} protected (final )?void init\(\) \{ => public $1void init() {
# Utilities: 1.8.9 has no accessibility settings.
file ui/screen/UtilitiesScreen.java
s import com\.flintclient\.client\.mc\.AccessibilityOptionsScreen;\n =>
s \t\t\tnew Row\("flintclient\.utilities\.accessibility"[^\n]*\n =>
