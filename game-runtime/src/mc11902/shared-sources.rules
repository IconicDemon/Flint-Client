s mc\.getReportingContext\(\)\.draftReportHandled\(mc, back, \(\) -> com\.flintclient\.client\.compat\.McCompat\.leaveWorld\(mc\),\n\t+true\) => com.flintclient.client.compat.McCompat.leaveWorld(mc)
s \(a report draft is offered first, as there\) => (1.19.2's offers no report draft first)

# ---------- vertices: 1.19.2's poses hold its own matrices, and a vertex ends with endVertex (compat/render/Verts) ----------
s-in {control/platform/Mc263Skins.java,control/platform/Mc263Capes.java,control/platform/Mc263CapeElytra.java} \bMatrix4f (\w+) = (\w+)\.pose\(\); => Matrix4f $1 = com.flintclient.client.compat.render.Verts.joml($2);
s-in {control/platform/Mc263Skins.java,control/platform/Mc263Capes.java,control/platform/Mc263CapeElytra.java} \bpose\.transformNormal\( => com.flintclient.client.compat.render.Verts.transformNormal(pose,
s-in {control/platform/Mc263Skins.java,control/platform/Mc263Capes.java,control/platform/Mc263CapeElytra.java} \b(buffer|b)\.addVertex\(POS\.x\(\), => com.flintclient.client.compat.render.Verts.vertex($1, POS.x(),
s-in control/platform/Mc263Skins.java \bpose\.last\(\)\.pose\(\)\.getTranslation\( => com.flintclient.client.compat.render.Verts.joml(pose.last()).getTranslation(
s-in control/platform/Mc263Visuals.java buffer\.addVertex\(pose, (\w+), (\w+), (\w+)\)\.setColor\(color\); => buffer.vertex(pose.pose(), $1, $2, $3).color(color).endVertex();
s-in control/platform/Mc263LootBeams.java vc\.addVertex\(p, x, y, z\)\.setColor\(r, g, b, a\)\.setUv\(u, v\)\.setOverlay\(OverlayTexture\.NO_OVERLAY\)\.setLight\(FULL_BRIGHT\)\.setNormal\(p, 0, 1, 0\); => vc.vertex(p.pose(), x, y, z).color(r, g, b, a).uv(u, v).overlayCoords(OverlayTexture.NO_OVERLAY).uv2(FULL_BRIGHT).normal(p.normal(), 0, 1, 0).endVertex();

file compat/MapQuads.java
s Matrix4f pose = g\.pose\(\)\.last\(\)\.pose\(\); => com.mojang.math.Matrix4f pose = g.pose().last().pose();
s BufferBuilder buffer = Tesselator\.getInstance\(\)\.begin\(VertexFormat\.Mode\.TRIANGLE_FAN, DefaultVertexFormat\.POSITION_TEX\); => BufferBuilder buffer = Tesselator.getInstance().getBuilder();\n\t\tbuffer.begin(VertexFormat.Mode.TRIANGLE_FAN, DefaultVertexFormat.POSITION_TEX);
s buffer\.addVertex\(pose, xy\[2 \* i\], xy\[2 \* i \+ 1\], 0\)\.setUv\(uv\[2 \* i\], uv\[2 \* i \+ 1\]\); => buffer.vertex(pose, xy[2 * i], xy[2 * i + 1], 0).uv(uv[2 * i], uv[2 * i + 1]).endVertex();
s BufferUploader\.drawWithShader\(buffer\.buildOrThrow\(\)\); => BufferUploader.drawWithShader(buffer.end());

file control/platform/Mc263HealthIndicators.java
# The hearts over players: 1.19.2 keeps them in icons.png (no GUI atlas; compat/GuiSprites has their places).
s new net\.minecraft\.resources\.ResourceLocation\("textures/atlas/gui\.png"\) => new net.minecraft.resources.ResourceLocation("textures/gui/icons.png")
s import net\.minecraft\.client\.renderer\.texture\.TextureAtlasSprite;\n =>
s \t+TextureAtlas atlas = \(TextureAtlas\) Minecraft\.getInstance\(\)\.getTextureManager\(\)\.getTexture\(GUI_ATLAS\);\n =>
s atlas\.getSprite\((\w+)\) => com.flintclient.client.compat.GuiSprites.region($1)
s \bTextureAtlasSprite\b => com.flintclient.client.compat.GuiSprites.Region
s !\(state instanceof Health health\) => !(((Object) state) instanceof Health health)
s poseStack\.mulPose\(new Matrix4f\(\)\.rotation\(camera\.orientation\)\); => com.flintclient.client.compat.McCompat.rotate(poseStack, camera.orientation);
s Matrix4f model = entry\.pose\(\); => com.mojang.math.Matrix4f model = entry.pose();
s private static void drawHeart\(Matrix4f model, => private static void drawHeart(com.mojang.math.Matrix4f model,
s private static void vertex\(Matrix4f model, => private static void vertex(com.mojang.math.Matrix4f model,
s vertices\.addVertex\(model, x, y, z\)\.setColor\(255, 255, 255, 255\)\.setUv\(u, v\)\.setOverlay\(0\)\.setLight\(15728880\)\.setNormal\(0\.0F, 0\.0F, 1\.0F\); => vertices.vertex(model, x, y, z).color(255, 255, 255, 255).uv(u, v).overlayCoords(0).uv2(15728880).normal(0.0F, 0.0F, 1.0F).endVertex();

file control/platform/MobFillLayer.java
# 1.19.2's models take their tint as four floats.
s OverlayTexture\.NO_OVERLAY, fill\) => OverlayTexture.NO_OVERLAY, (fill >> 16 & 0xFF) / 255.0F, (fill >> 8 & 0xFF) / 255.0F, (fill & 0xFF) / 255.0F, (fill >>> 24) / 255.0F)

