file control/platform/Mc263Hitbox.java
# Reach: 1.19.2 has no interaction-range attribute (survival 3, creative 6 for entities, as its GameRenderer picks them).
s box\.distanceToSqr\( => com.flintclient.client.compat.McCompat.distanceToSqr(box,
s player\.entityInteractionRange\(\) \* player\.entityInteractionRange\(\) => com.flintclient.client.compat.McCompat.entityReach(player) * com.flintclient.client.compat.McCompat.entityReach(player)
s vehicle\.getPassengerRidingPosition\(entity\) => vehicle.position().add(0.0, vehicle.getPassengersRidingOffset() + entity.getMyRidingOffset(), 0.0)

