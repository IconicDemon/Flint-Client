file control/platform/Mc263HudData.java
# The sidebar as 1.19.2's Gui draws it: display slots are numbers (1 the sidebar, 3 + a team colour's id; McCompat.teamSidebar
# answers -1 for none), its scores come in its order, lowest first, with no number formats (1.20.3), names starting with # are
# left out and the last 15 shown (counted from all the objective's scores, as 1.19.2 counts them); each line is the name, ": "
# and the score, and a sidebar with no scores draws nothing.
s import net\.minecraft\.network\.chat\.numbers\.NumberFormat;\n =>
s import net\.minecraft\.network\.chat\.numbers\.StyledFormat;\n =>
s import net\.minecraft\.world\.scores\.DisplaySlot;\n =>
s import net\.minecraft\.world\.scores\.PlayerScoreEntry;\n => import net.minecraft.world.scores.Score;\n
s (?s)\t/\*\* \{@code Hud\.SCORE_DISPLAY_ORDER\}.*?String\.CASE_INSENSITIVE_ORDER\);\n\n =>
s DisplaySlot slot = (com\.flintclient\.client\.compat\.McCompat\.teamSidebar\(team\));\n(\t+)if \(slot != null\) \{ => int slot = $1;\n$2if (slot >= 0) {
s DisplaySlot\.SIDEBAR => Scoreboard.DISPLAY_SLOT_SIDEBAR
s (?s)\t\tList<PlayerScoreEntry> shown = new ArrayList<>\(\);\n.*?\t\treturn new int\[\] \{widest, lines\};\n => \t\tjava.util.Collection<Score> scores = scoreboard.getPlayerScores(objective);\n\t\tList<Score> shown = new ArrayList<>();\n\t\tfor (Score score : scores) {\n\t\t\tif (score.getOwner() != null && !score.getOwner().startsWith("#")) {\n\t\t\t\tshown.add(score);\n\t\t\t}\n\t\t}\n\t\tif (shown.size() > 15) {\n\t\t\tshown = shown.subList(Math.min(shown.size(), scores.size() - 15), shown.size());\n\t\t}\n\t\tint lines = shown.size();\n\t\tif (lines == 0) {\n\t\t\treturn null;\n\t\t}\n\t\tFont font = minecraft.font;\n\t\tint widest = font.width(objective.getDisplayName());\n\t\tint spacer = font.width(": ");\n\t\tfor (Score score : shown) {\n\t\t\tComponent name = PlayerTeam.formatNameForTeam(scoreboard.getPlayersTeam(score.getOwner()), Component.literal(score.getOwner()));\n\t\t\twidest = Math.max(widest, font.width(name) + spacer + font.width(Integer.toString(score.getScore())));\n\t\t}\n\t\treturn new int[] {widest, lines};\n
# 1.19.2's worlds always run at 20 ticks a second (1.20.3 let servers change the tick rate).
