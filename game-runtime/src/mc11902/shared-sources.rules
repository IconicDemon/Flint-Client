file platform/MenuHost.java
# Discover's Join: 1.19.2's ServerData only says whether a server is on your LAN, and its connect screen has no Quick Play flag or transfer.
s net\.minecraft\.client\.multiplayer\.ServerData\.Type\.OTHER\) => false)
s (ConnectScreen\.startConnecting\([^;]*?), false, null\) => $1)

# ---------- the hot loader (hotload/HotLoader) on 1.19.x ----------
# As on 1.21.x (whose overlay has these rules too: s* here, so they do nothing once the 1.21.11 overlay's have run): Fabric API's
# key registry is the key binding one, Minecraft's fields have intermediary names at run time (the key list is set through
# mixin/bridge/OptionsKeysAccessor), a key is found by its name in the list and pressed by its saved name.
file hotload/HotLoader.java
s* net\.fabricmc\.fabric\.impl\.client\.keymapping\.KeyMappingRegistryImpl => net.fabricmc.fabric.impl.client.keybinding.KeyBindingRegistryImpl
s* field\(net\.minecraft\.client\.Options\.class, "keyMappings"\)\.set\(mc\.options, next\) => ((com.flintclient.client.mixin.bridge.OptionsKeysAccessor) mc.options).flint\$keyMappings(next)
s* KeyMapping key = KeyMapping\.get\(name\); => KeyMapping key = Arrays.stream(Minecraft.getInstance().options.keyMappings).filter(k -> k.getName().equals(name)).findFirst().orElse(null);
s* \(com\.mojang\.blaze3d\.platform\.InputConstants\.Key\) field\(KeyMapping\.class, "key"\)\.get\(key\) => com.mojang.blaze3d.platform.InputConstants.getKey(key.saveString())
s* \} catch \(ReflectiveOperationException e\) \{\n(\t+)return "failed " => } catch (RuntimeException e) {\n$1return "failed "
# The hook (thirdparty/mixin/HotLoadKeyMappingMixin) is this overlay's own file; it applies when Fabric API's key binding module is there.
file thirdparty/ThirdPartyMixinPlugin.java
s* "fabric-key-mapping-api-v1" => "fabric-key-binding-api-v1"

# ---------- Sodium on 1.19.x ----------
# Sodium 0.4.4 (1.19.2's) overwrites SingleQuadParticle.render (MixinBillboardParticle), which Mixin won't inject into: the
# game crashed at start with it. Particle Changer's opacity hook (mixin/feature/ParticleOpacityMixin) is left out while Sodium
# is loaded (its particles are drawn by Sodium's own writer then).
file FlintMixinPlugin.java
s public boolean shouldApplyMixin\(String targetClassName, String mixinClassName\) \{\n(\t+)return true; => public boolean shouldApplyMixin(String targetClassName, String mixinClassName) {\n$1return !mixinClassName.endsWith(".ParticleOpacityMixin") || !net.fabricmc.loader.api.FabricLoader.getInstance().isModLoaded("sodium");
