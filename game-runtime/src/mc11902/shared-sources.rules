# How Minecraft 1.19.2 builds the sources, on top of the 1.21.1 overlay (overlay.properties): these rules apply to the shared
# sources as 1.21.11's, 1.21.10's and 1.21.1's rules left them and to their own files; files in java/ replace those of the same path.
# Rule forms: legacy/buildSrc/src/main/java/SharedSources.java. Every rule must still match.
#
# 1.19.2 predates what 1.21.1 already had and the shared sources draw with: GuiGraphics (1.20; compat/GuiGraphics stands in, drawing
# with 1.19's PoseStack and GuiComponent calls), JOML (1.19.3; Flint carries it, compat/MatrixBridge reads Minecraft's own
# matrices as JOML's), the built-in registries (1.19.3), data components (1.20.5), GUI sprites (1.20.2; compat/GuiSprites) and the
# widget, tooltip and toast APIs of 1.19.3 to 1.20. It runs on Java 17 (compat/J17 has the Java 21 methods the sources use).

# ---------- Java 17: Java 21's library methods (compat/J17) ----------
s-in ** \bMath\.clamp\( => com.flintclient.client.compat.J17.clamp(
s-in ** ([\w.]+(?:\(\))?)\.threadId\(\) => com.flintclient.client.compat.J17.threadId($1)

# ---------- GuiGraphics (1.20): Flint's stand-in, made over the PoseStack 1.19.2 hands out ----------
replace net.minecraft.client.gui.GuiGraphics com.flintclient.client.compat.GuiGraphics

# ---------- names 1.19.3 to 1.21 brought ----------
s-in ** (?:net\.minecraft\.resources\.)?ResourceLocation\.fromNamespaceAndPath\( => new net.minecraft.resources.ResourceLocation(
s-in ** (?:net\.minecraft\.resources\.)?ResourceLocation\.withDefaultNamespace\( => new net.minecraft.resources.ResourceLocation(
s-in ** (?:net\.minecraft\.resources\.)?ResourceLocation\.parse\( => new net.minecraft.resources.ResourceLocation(

# ---------- classes 1.19.3 to 1.21 added: Flint's stand-ins (compat/) ----------
word com.mojang.math.Axis com.flintclient.client.compat.Axis
word net.minecraft.client.DeltaTracker com.flintclient.client.compat.DeltaTracker
word net.minecraft.client.gui.navigation.ScreenRectangle com.flintclient.client.compat.ScreenRectangle
word net.minecraft.client.gui.components.Tooltip com.flintclient.client.compat.Tooltip
# Classes 1.19.3 to 1.21 moved.
word net.minecraft.client.gui.screens.options.ChatOptionsScreen net.minecraft.client.gui.screens.ChatOptionsScreen
word net.minecraft.client.gui.screens.options.LanguageSelectScreen net.minecraft.client.gui.screens.LanguageSelectScreen
word net.minecraft.client.gui.screens.options.AccessibilityOptionsScreen net.minecraft.client.gui.screens.AccessibilityOptionsScreen
word net.minecraft.client.gui.screens.options.SkinCustomizationScreen net.minecraft.client.gui.screens.SkinCustomizationScreen
word net.minecraft.client.gui.screens.options.OptionsSubScreen net.minecraft.client.gui.screens.OptionsSubScreen
word net.minecraft.client.gui.screens.options.controls.KeyBindsScreen net.minecraft.client.gui.screens.controls.KeyBindsScreen
word net.minecraft.world.level.chunk.status.ChunkStatus net.minecraft.world.level.chunk.ChunkStatus
word GenericMessageScreen GenericDirtMessageScreen

# ---------- mixins 1.19.2 can't take, or has its own of (java/) ----------
# GuiGraphics is Flint's own class on 1.19.2 (compat/GuiGraphics, which has the bridge's methods itself).
skip mixin/GraphicsBridgeMixin.java
skip mixin/bridge/GuiGraphicsInvoker.java
# Data components (1.20.5): 1.19.2 keeps a container's items in its NBT.
skip mixin/bridge/ContainerContentsBridgeMixin.java

# ---------- screens and widgets: 1.19.2 hands them a PoseStack (compat/GuiGraphics is made over it) ----------
# A screen's render, and a widget's (1.20's renderWidget is 1.19.2's renderButton, which is public).
s-in {platform/HostScreen.java,ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} public (final )?void render\(GuiGraphics (\w+), int (\w+), int (\w+), float (\w+)\) \{ => public $1void render(com.mojang.blaze3d.vertex.PoseStack flint\$pose, int $3, int $4, float $5) {\n\t\tGuiGraphics $2 = GuiGraphics.of(flint\$pose);
s-in ui/widget/*.java (?:protected|public) (final )?void renderWidget\(GuiGraphics (\w+), int (\w+), int (\w+), float (\w+)\) \{ => public $1void renderButton(com.mojang.blaze3d.vertex.PoseStack flint\$pose, int $3, int $4, float $5) {\n\t\tGuiGraphics $2 = GuiGraphics.of(flint\$pose);
s-in {ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} \b(\w+)\.render\((graphics|guiGraphics), => $1.render($2.pose(),
# A Flint screen's background, which 1.20.2 draws before render(): 1.19.2's renderBackground(PoseStack), which compat/ScreenFrame
# calls for Flint's screens before they draw (with the frame's pointer and partial tick).
s-in {platform/HostScreen.java,ui/screen/*.java,control/platform/WorldMapScreen.java} public (final )?void renderBackground\(GuiGraphics (\w+), int (\w+), int (\w+), float (\w+)\) \{ => public $1void renderBackground(com.mojang.blaze3d.vertex.PoseStack flint\$pose) {\n\t\tGuiGraphics $2 = GuiGraphics.of(flint\$pose);\n\t\tint $3 = com.flintclient.client.compat.ScreenFrame.mouseX();\n\t\tint $4 = com.flintclient.client.compat.ScreenFrame.mouseY();\n\t\tfloat $5 = com.flintclient.client.compat.ScreenFrame.partialTick();


# ---------- entity and world rendering ----------
# Player skins (1.20.2's record): Flint's stand-in (compat/PlayerSkin), which PlayerInfoMixin and AbstractClientPlayerMixin hand
# out from 1.19.2's four skin getters (compat.render.SkinBridge, added to both classes by loom/fabric.mod.json).
replace net.minecraft.client.resources.PlayerSkin com.flintclient.client.compat.PlayerSkin
s-in ** \bDefaultPlayerSkin\.get\( => com.flintclient.client.compat.render.SkinBridge.byDefault(
# 1.19.4's font display modes: 1.19.2's font takes a see-through flag (compat.render.DisplayMode stands in).
replace Font.DisplayMode com.flintclient.client.compat.render.DisplayMode
# 1.20's debug quads, Flint's on 1.19.2 (compat.render.DebugRenderTypes; debugFilledBox() too, which only compat/gizmos used).
replace RenderType.debugQuads() com.flintclient.client.compat.render.DebugRenderTypes.debugQuads()
# 1.19.4's item display contexts are 1.19.2's item transform types (the same constants).
replace net.minecraft.world.item.ItemDisplayContext net.minecraft.client.renderer.block.model.ItemTransforms
word ItemDisplayContext ItemTransforms.TransformType
# Text displays (1.19.4): 1.19.2 has none, so no server hangs a text-display nametag on a player; Tier Tagger tags the
# nametags 1.19.2 has (EntityRendererMixin).
skip mixin/feature/TextDisplayTierMixin.java
file control/platform/Mc263Tiers.java
s import net\.minecraft\.world\.entity\.Display;\n =>
s (?s)\t/\*\* A server's text-display nametag as last changed.*?\n\tprivate static final Map<Display\.TextDisplay, DisplayTag> DISPLAYS = new java\.util\.WeakHashMap<>\(\);\n =>
s (?s)\n\t/\*\*\n\t \* A server's text-display nametag riding a player:.*\n\}\n?$ => }\n
file platform/FontSets.java
# 1.19.2 makes and measures a TrueType font its own way (1.20 brought the definitions, the em sizing and the fixed baseline):
# compat/render/TrueTypeFonts makes Flint's fonts the size and place 1.20 gives them; a font it can't read throws, as a definition does.
s import net\.minecraft\.client\.gui\.font\.providers\.TrueTypeGlyphProviderDefinition; => import net.minecraft.client.gui.font.providers.TrueTypeGlyphProviderBuilder;
s (?s)TrueTypeGlyphProviderDefinition definition = new TrueTypeGlyphProviderDefinition\(\n\t+(new net\.minecraft\.resources\.ResourceLocation\(FlintClient\.MOD_ID, path\)), size, oversample, TrueTypeGlyphProviderDefinition\.Shift\.NONE, ""\);\n(\t+)return definition\.unpack\(\)\.left\(\)\.orElseThrow\(\)\.load\(resources\); => return com.flintclient.client.compat.render.TrueTypeFonts.load(resources, $1, size, oversample);


# ---------- Flint's built-in resource pack (no Fabric API): 1.19.2 has no PackLocationInfo, PackSelectionConfig or
# PathPackResources (1.19.3 to 1.20.5): compat/misc/BuiltInPack makes the pack and mixin/control/ClientPackSourceMixin offers it ----------
skip control/platform/BuiltInPackSupplier.java
file control/platform/BuiltInResources.java
s import net\.minecraft\.server\.packs\.PackLocationInfo;\n => 
s import net\.minecraft\.server\.packs\.PackSelectionConfig;\n => 
s import net\.minecraft\.server\.packs\.PathPackResources;\n => 
s import net\.minecraft\.server\.packs\.metadata\.MetadataSectionType;\n => 
s import net\.minecraft\.server\.packs\.resources\.ResourceMetadata;\n => 
s \tprivate static final PackSelectionConfig SELECTION = [^\n]*\n => 
s // Called by Minecraft straight after the scan; a null pack is left out \(BuiltInPackSource\.listBundledPacks\)\. => // Called as the scan offers the pack (ClientPackSourceMixin); a null pack is left out.
s (?s)\t\t\tPackLocationInfo location = new PackLocationInfo\([^\n]*\n\t\t\treturn Pack\.readMetaAndCreate\([^\n]*\n => \t\t\treturn com.flintclient.client.compat.misc.BuiltInPack.create(id, Component.literal(FlintClient.NAME), root);\n
s (?s)\n\t/\*\* The jar's files, with the pack's metadata answered from code.*?\n\t\}\n\}\n?$ => }\n


# ---------- network, chat safety, account switching (the net group: java/ has 1.19.2's own of the rest) ----------
# 1.21's disconnection details: 1.19.2's disconnects carry only their reason (compat/net/DisconnectionDetails, which the
# network mixins make from it).
word net.minecraft.network.DisconnectionDetails com.flintclient.client.compat.net.DisconnectionDetails

file mixin/ncr/NcrOptionsSubScreenMixin.java
# 1.19.2's chat options are a SimpleOptionsSubScreen, which keeps the option list (privately).
s @Mixin\(OptionsSubScreen\.class\) => @Mixin(net.minecraft.client.gui.screens.SimpleOptionsSubScreen.class)
s \tprotected OptionsList list; => \tprivate OptionsList list;

file control/platform/Mc263ChatSafety.java
# 1.19.2 has no chat sessions (1.19.3): the server learns your key from the login hello and nowhere else, and a connection's
# key state is decided as it begins (compat/net/LoginSigning), so signing allowed during a session starts with the next join and
# what waited for a session to start is dropped.
s (?s)ClientPacketListener connection = mc\.player\.connection;\n\t+Session session = \(Session\) connection;\n\t+if \(session\.flint\$chatSession\(\) == null\) \{\n.*?\}\), mc\);\n\t+\} => SIGNING_ACTIONS.clear();
# 1.19.2's key manager is a class with no prepareKeyPair: its key is read off the render thread (joining its own first lookup).
s real\.prepareKeyPair\(\)\.whenComplete => java.util.concurrent.CompletableFuture.supplyAsync(real::profilePublicKey, net.minecraft.Util.backgroundExecutor()).whenComplete
# A join that already signs (Always, or allowed when the server turned the last try away for want of a key) is on a server
# that wants signed chat.
s \} else if \(mode\(lastServer\) == Mode\.ALWAYS\) \{ => } else if (mode(lastServer) == Mode.ALWAYS || allowSigning()) {
# The trust level: 1.19.2 works it out from the sender's chain of signed messages (each check moves the chain on), so the hook
# hands over the level Minecraft found instead of working it out again; 1.19.2's messages name their signer and signature so.
s ChatTrustLevel trust\(PlayerChatMessage message, Component decorated, java\.time\.Instant received, boolean fromYou\) => ChatTrustLevel trust(PlayerChatMessage message, Component decorated, ChatTrustLevel vanilla, boolean fromYou)
s message\.sender\(\), message\.hasSignature\(\)\) => message.signer().profileId(), !message.headerSignature().isEmpty())
s if \(message\.hasSignature\(\) && current == Level\.SECURE\) => if (!message.headerSignature().isEmpty() && current == Level.SECURE)
s ChatTrustLevel level = ChatTrustLevel\.evaluate\(message, decorated, received\); => ChatTrustLevel level = vanilla;
# Always chosen during a session signs from the next join on 1.19.2, not "once you send any message".
s signing \+= allowSigning\(\) \? "allowed" : "disabled_allowance_pending"; => signing += allowSigning() ? "allowed" : "disabled";
# 1.19.2's server status keeps its version behind getters (and may have none).
s if \(status\.version\(\)\.isPresent\(\)\) \{\n(\t+)int protocol = status\.version\(\)\.get\(\)\.protocol\(\); => if (status.getVersion() != null) {\n$1int protocol = status.getVersion().getProtocol();
# Convert to system messages: 1.19.2's player chat packet carries the message and its chat type by registry id, which the world
# you host resolves.
s return new ClientboundSystemChatPacket\(chat\.chatType\(\)\.decorate\(content != null \? content : Component\.literal\(chat\.body\(\)\.content\(\)\)\), false\); => net.minecraft.server.MinecraftServer host = Minecraft.getInstance().getSingleplayerServer();\n\t\treturn host == null ? null : chat.chatType().resolve(host.registryAccess())\n\t\t\t.map(bound -> new ClientboundSystemChatPacket(bound.decorate(content != null ? content : chat.message().signedContent().decorated()), false))\n\t\t\t.orElse(null);

file module/account/SessionSwitch.java
# 1.19.2 looks the signed-in profile's properties up when they're first asked for (emptied, they're looked up again for the new
# user); its user API service fetches its own properties as it's made; and it makes telemetry for each connection from the user
# and the service, so there is none to replace. Every user has a key manager of its own (an offline one has no keys:
# compat/net/NoKeys).
s (?s)\t\tgame\.flint\$setProfileFuture\(.*?\}, Util\.(?:nonCriticalIoPool|ioPool)\(\)\)\);\n => \t\tgame.flint\$profileProperties().clear();\n
s (?s)\t\tClientTelemetryManager telemetry = game\.flint\$telemetryManager\(\);\n.*?\t\t\}\n(\t\tgame\.flint\$setProfileKeyPairManager) => $1
s import net\.minecraft\.client\.telemetry\.ClientTelemetryManager;\n =>
s ProfileKeyPairManager\.EMPTY_KEY_MANAGER\n(\t+): ProfileKeyPairManager\.create\(api, user, minecraft\.gameDirectory\.toPath\(\)\) => com.flintclient.client.compat.net.NoKeys.MANAGER\n$1: new ProfileKeyPairManager(api, user.getGameProfile().getId(), minecraft.gameDirectory.toPath())

# ---------- chat safety mixins 1.19.2 can't take ----------
# The options' Telemetry Data button came in 1.19.3 (and 1.19.2 has no GridLayout): nothing to remove.
skip mixin/ncr/NcrRowHelperMixin.java
# The world you host drops players' keys at login (NcrChatSessionUpdateMixin, java/), and 1.19.2's server reads no signature
# from a player without a key: chat and command signatures are ignored already, and stripping a keyed player's would get them
# kicked for "unsigned chat".
skip mixin/ncr/NcrServerboundChatPacketMixin.java
skip mixin/ncr/NcrServerboundCommandSignedMixin.java

# ConnectScreen.startConnecting has no Quick Play flag or transfer on 1.19.2 (Reconnect, the title screen's server slots).
s-in {control/platform/Mc263Reconnect.java,ui/screen/FlintTitleScreen.java} (ConnectScreen\.startConnecting\([^;]*?), false, null\) => $1)

# ---------- GUI mixins 1.19.2 has no use for (the gui group: java/ has 1.19.2's own of the rest) ----------
# 1.19.2's F3 switch is options.renderDebug, not a field of the overlay (compat/DebugEntries reads it).
skip mixin/bridge/DebugScreenOverlayAccessor.java
# Flint draws every tooltip on 1.19.2 (compat/Tooltips, with Scrollable Tooltips and Glint's backgrounds in it).
skip mixin/feature/GuiGraphicsTooltipMixin.java
skip mixin/feature/GlintBackgroundMixin.java
# Menu blur (1.20.5): 1.19.2's menus have none (menu_blur says so, compat/ModuleAvailability).
skip mixin/feature/OptionsFeatureMixin.java

# ---------- advancements: 1.20.2's tree over 1.19.2's list (compat/AdvancementTree), an advancement is its own holder ----------
word net.minecraft.advancements.AdvancementHolder net.minecraft.advancements.Advancement
word AdvancementHolder Advancement
word net.minecraft.advancements.AdvancementNode com.flintclient.client.compat.AdvancementNode

# ---------- the scroll wheel: 1.20.2 added a horizontal amount; 1.19.2 hands over the vertical one only ----------
s-in {platform/HostScreen.java,ui/screen/*.java,control/platform/WorldMapScreen.java} public (final )?boolean mouseScrolled\(double (\w+), double (\w+), double (\w+), double (\w+)\) \{ => public $1boolean mouseScrolled(double $2, double $3, double $5) {\n\t\tdouble $4 = 0.0;
s-in ui/screen/*.java super\.mouseScrolled\(((?:[^,()]|\([^()]*\))+), ((?:[^,()]|\([^()]*\))+), \w+, (\w+)\) => super.mouseScrolled($1, $2, $3)

# ---------- registries: 1.19.2 keeps the built-in registries and their keys on Registry (1.19.3 moved them) ----------
replace net.minecraft.core.registries.BuiltInRegistries net.minecraft.core.Registry
word BuiltInRegistries Registry
replace net.minecraft.core.registries.Registries net.minecraft.core.Registry
s-in ** \bRegistries\.([A-Z_]+)\b => Registry.$1_REGISTRY

# ---------- names 1.19.3 to 1.20 changed ----------
# An entity's level is a field with a getter on 1.19.2 (1.20 made level() the getter); Flint's own static level() stays.
s-in ** \b(?!(?:Mc263)?HudData\b)(\w+)\.level\(\) => $1.getLevel()
s-in ** \.onGround\(\) => .isOnGround()
# 1.19.4's BlockPos.containing: 1.19.2's constructor floors the same way.
s-in ** (?:net\.minecraft\.core\.)?BlockPos\.containing\( => new net.minecraft.core.BlockPos(
s-in ** \bUtil\.nonCriticalIoPool\(\) => Util.ioPool()
# Effects: 1.19.2's instance names its MobEffect itself (1.20.5 made it a holder); an effect without a counter (its "**:**")
# is the infinite one of 1.19.4.
s-in ** \.getEffect\(\)\.value\(\) => .getEffect()
s-in ** \.isInfiniteDuration\(\) => .isNoCounter()
s-in ** \bHolder<MobEffect>(\s) => MobEffect$1
s-in ** \(Holder<MobEffect>\) => (MobEffect)
# 1.19.3's ResourceLocation.withPath (Flint's maps and leaves name a sprite's file from its id).
s-in ** \b(\w+)\.withPath\((\w+) -> ([^;]*?)\);\n => new net.minecraft.resources.ResourceLocation($1.getNamespace(), java.util.Objects.requireNonNull(((java.util.function.UnaryOperator<String>) $2 -> $3).apply($1.getPath())));\n

# ---------- widgets and screens 1.19.3 to 1.20.2 added (compat/) ----------
s-in ** \bButton\.builder\( => com.flintclient.client.compat.ButtonBuilder.of(
word net.minecraft.client.gui.screens.FaviconTexture com.flintclient.client.compat.FaviconTexture
s-in ** (?:net\.minecraft\.client\.gui\.screens\.)?ConfirmLinkScreen\.confirmLinkNow\( => com.flintclient.client.compat.McCompat.confirmLink(
# 1.20.2's server kinds: 1.19.2's ServerData only says whether a server is on your LAN.
s-in ** new ServerData\(([^;]*?), ServerData\.Type\.(?:OTHER|REALM)\) => new ServerData($1, false)
file ui/screen/FlintTitleScreen.java
# 1.19.2 keeps a server's icon as base64 text (1.20 as bytes), read as an image from a stream.
s data\.getIconBytes\(\) => com.flintclient.client.compat.McCompat.iconBytes(data)
s NativeImage\.read\(bytes\) => NativeImage.read(new java.io.ByteArrayInputStream(bytes))

# ---------- Flint's host screen on 1.19.2's screen life cycle ----------
# 1.19.3 to 1.20 added added() (before the first init), setInitialFocus() (after init) and repositionElements() (a resize
# keeps the screen; 1.19.2 builds it again): here shown() runs before the first init, the initial focus after each init,
# and a resize updates the size and lays the kit out again without building it anew.
file platform/HostScreen.java
s (\t@Override\n\tprotected final void init\(\) \{\n)(\t\ttry \{\n\t\t\topened\(\);\n\t\t\} catch \(RuntimeException \| LinkageError e\) \{\n\t\t\tbroke\("opening", e\);\n\t\t\}\n)(\t\})\n => $1\t\tif (!flint\$shown) {\n\t\t\tflint\$shown = true;\n\t\t\tflint\$added();\n\t\t}\n$2\t\tflint\$setInitialFocus();\n$3\n\n\t/** Whether shown() has run for this showing (1.19.2 has no added()). */\n\tprivate boolean flint\$shown;\n\n\t@Override\n\tpublic final void resize(net.minecraft.client.Minecraft flint\$minecraft, int flint\$width, int flint\$height) {\n\t\twidth = flint\$width;\n\t\theight = flint\$height;\n\t\tflint\$repositionElements();\n\t}\n
s \t@Override\n\tprotected final void repositionElements\(\) \{ => \tprivate void flint\$repositionElements() {
s \t@Override\n\tprotected final void setInitialFocus\(\) \{ => \tprivate void flint\$setInitialFocus() {
s \t@Override\n\tpublic final void added\(\) \{ => \tprivate void flint\$added() {
s (\t@Override\n\tpublic final void removed\(\) \{\n) => $1\t\tflint\$shown = false;\n
s \t@Override\n(\tprotected final boolean shouldNarrateNavigation\(\)) => $1


# ---------- item data: 1.20.5's data components and 1.21's data-driven enchantments, which 1.19.2 keeps in an item's NBT ----------
# compat/item has Flint's stand-ins, read from 1.19.2's item and NBT: DataComponents (the components the sources read), a stack's
# get/has/getOrDefault/set (compat.item.ItemStackBridge, added to ItemStack by loom/fabric.mod.json and mixin.bridge
# .ItemStackBridgeMixin), the enchantments (by registry holder, with Enchantments' 1.21 keys), potion contents, lore, a
# container's and a bundle's items, and the food values (saturation as 1.20.5 stores it: nutrition × modifier × 2).
word net.minecraft.core.component.DataComponents com.flintclient.client.compat.item.DataComponents
word net.minecraft.world.item.enchantment.ItemEnchantments com.flintclient.client.compat.item.ItemEnchantments
word net.minecraft.world.item.enchantment.Enchantments com.flintclient.client.compat.item.Enchantments
word net.minecraft.world.item.alchemy.PotionContents com.flintclient.client.compat.item.PotionContents
word net.minecraft.world.item.component.ItemLore com.flintclient.client.compat.item.ItemLore
word net.minecraft.world.item.component.ItemContainerContents com.flintclient.client.compat.item.ItemContainerContents
word net.minecraft.world.item.component.BundleContents com.flintclient.client.compat.item.BundleContents
word-in control/platform/Mc263Food.java net.minecraft.world.food.FoodProperties com.flintclient.client.compat.item.FoodProperties
# 1.19.2 compares two stacks' NBT where 1.20.5 compares their components (the same test), and keeps a rarity's colour as a field.
word isSameItemSameComponents isSameItemSameTags
replace getRarity().color() getRarity().color
# An enchantment names itself at a level (1.21 asks Enchantment with its holder), and EnchantmentHelper.getEnchantments is
# 1.21's getEnchantmentsForCrafting (a book's stored enchantments, any other item's own).
s-in ** \bEnchantment\.getFullname\(([\w.]+(?:\(\))?),\s* => $1.value().getFullname(
s-in ** \bEnchantmentHelper\.getEnchantmentsForCrafting\( => com.flintclient.client.compat.item.ItemEnchantments.forCrafting(
# A dye's texture colour: 1.19.2 keeps it as three floats (ItemCompat makes 1.21's ARGB of them).
s-in ** \b([\w.]+(?:\(\))?)\.getTextureDiffuseColor\(\) => com.flintclient.client.compat.item.ItemCompat.textureDiffuseColor($1)
# 1.21.1's Equipable items (1.19.4 added the interface): 1.19.2's armor, horse armor, elytra and shields (ItemCompat).
s-in ** \b([\w.]+(?:\(\))?) instanceof net\.minecraft\.world\.item\.Equipable\b => com.flintclient.client.compat.item.ItemCompat.equipable($1)
# 1.19.2 has no sword, axe, pickaxe or shovel item tags (1.19.4 added them): its tools of each kind are of their item class.
s-in ** \b([\w.]+(?:\(\))?)\.is\((?:net\.minecraft\.tags\.)?ItemTags\.SWORDS\) => ($1.getItem() instanceof net.minecraft.world.item.SwordItem)
s-in ** \b([\w.]+(?:\(\))?)\.is\((?:net\.minecraft\.tags\.)?ItemTags\.AXES\) => ($1.getItem() instanceof net.minecraft.world.item.AxeItem)
s-in ** \b([\w.]+(?:\(\))?)\.is\((?:net\.minecraft\.tags\.)?ItemTags\.PICKAXES\) => ($1.getItem() instanceof net.minecraft.world.item.PickaxeItem)
s-in ** \b([\w.]+(?:\(\))?)\.is\((?:net\.minecraft\.tags\.)?ItemTags\.SHOVELS\) => ($1.getItem() instanceof net.minecraft.world.item.ShovelItem)
# The mace and the wind charge came in 1.21: no 1.19.2 item is one (Armor's Mace slot, UHC Overlay's Mace scale and Attack
# Indicator's Wind charge are shown unavailable, compat/ModuleAvailability).
s-in ** \b\w+\.is\((?:net\.minecraft\.world\.item\.)?Items\.(?:MACE|WIND_CHARGE)\) => false
file control/platform/Mc263LootBeams.java
s import net\.minecraft\.world\.item\.MaceItem;\n =>
s \n\t+\|\| item instanceof MaceItem\) => )
file control/platform/Mc263Inventory.java
# Enchantment summaries: a curse is one by its enchantment (1.21 by a tag), named by its description id, and listed where the
# item's tooltip lists it: 1.19.2 has no tooltip-order tag, its tooltip follows the order the item keeps them in.
s import net\.minecraft\.tags\.EnchantmentTags;\n =>
s (\w+)\.is\(EnchantmentTags\.CURSE\) => $1.value().isCurse()
