# How Minecraft 1.21.1 builds the sources, on top of the 1.21.10 overlay (overlay.properties): these rules apply to the shared
# sources as 1.21.11's and 1.21.10's rules left them and to their own files; files in java/ replace those of the same path.
# Rule forms: legacy/buildSrc/src/main/java/SharedSources.java. Every rule must still match.
#
# 1.21.1 predates most of what the shared sources draw with: GUI render state and strata (1.21.6), render pipelines and the GPU
# device (1.21.5), item models (1.21.4), entity render states (1.21.2), input events and submit nodes (1.21.9). The GUI is
# bridged (compat/GraphicsBridge, compat/Pose2D, compat/RenderPipelines, compat/input); features 1.21.1 can't have are
# switched off with the reason on their page (compat/McCompat.unavailable).

# ---------- input events: 1.21.9's records are Flint's own here (compat/input), and the overrides take 1.21.1's raw values ----------
replace net.minecraft.client.input. com.flintclient.client.compat.input.
s-in {platform/HostScreen.java,ui/kit/InlineConfirm.java,ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} public boolean keyPressed\(((?:[\w.]+\.)?KeyEvent) (\w+)\) \{ => public boolean keyPressed(int flint\$key, int flint\$scancode, int flint\$modifiers) {\n\t\t$1 $2 = new $1(flint\$key, flint\$scancode, flint\$modifiers);
s-in {platform/HostScreen.java,ui/screen/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} public boolean keyReleased\(KeyEvent (\w+)\) \{ => public boolean keyReleased(int flint\$key, int flint\$scancode, int flint\$modifiers) {\n\t\tKeyEvent $1 = new KeyEvent(flint\$key, flint\$scancode, flint\$modifiers);
s-in {platform/HostScreen.java,ui/screen/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} public boolean charTyped\(CharacterEvent (\w+)\) \{ => public boolean charTyped(char flint\$char, int flint\$modifiers) {\n\t\tCharacterEvent $1 = new CharacterEvent(flint\$char, flint\$modifiers);
s-in {platform/HostScreen.java,ui/kit/InlineConfirm.java,ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} public boolean mouseClicked\(MouseButtonEvent (\w+), boolean (\w+)\) \{ => public boolean mouseClicked(double flint\$x, double flint\$y, int flint\$button) {\n\t\tMouseButtonEvent $1 = com.flintclient.client.compat.input.Events.mouse(flint\$x, flint\$y, flint\$button);\n\t\tboolean $2 = com.flintclient.client.compat.input.Events.doubleClick(flint\$x, flint\$y, flint\$button);
s-in {platform/HostScreen.java,ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} public boolean mouseReleased\(MouseButtonEvent (\w+)\) \{ => public boolean mouseReleased(double flint\$x, double flint\$y, int flint\$button) {\n\t\tMouseButtonEvent $1 = com.flintclient.client.compat.input.Events.mouse(flint\$x, flint\$y, flint\$button);
s-in {platform/HostScreen.java,ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} public boolean mouseDragged\(MouseButtonEvent (\w+), double (\w+), double (\w+)\) \{ => public boolean mouseDragged(double flint\$x, double flint\$y, int flint\$button, double $2, double $3) {\n\t\tMouseButtonEvent $1 = com.flintclient.client.compat.input.Events.mouse(flint\$x, flint\$y, flint\$button);
s-in ui/widget/*.java public void onPress\(InputWithModifiers \w+\) \{ => public void onPress() {
s-in ui/widget/*.java super\.onPress\(\w+\) => super.onPress()
# …and their calls on the screens and widgets they extend, in 1.21.1's form.
s-in {ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} super\.keyPressed\((\w+)\) => super.keyPressed($1.key(), $1.scancode(), $1.modifiers())
s-in {ui/screen/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} super\.charTyped\((\w+)\) => super.charTyped((char) $1.codepoint(), $1.modifiers())
s-in {ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} super\.mouseClicked\((\w+|MenuScale\.toMenu\(\w+\)), \w+\) => super.mouseClicked(($1).x(), ($1).y(), ($1).button())
s-in {ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} super\.mouseReleased\((\w+|MenuScale\.toMenu\(\w+\))\) => super.mouseReleased(($1).x(), ($1).y(), ($1).button())
s-in {ui/screen/*.java,ui/widget/*.java,control/keys/KeyBindsSearchScreen.java,control/platform/TierSearchScreen.java,control/platform/WorldMapScreen.java,control/platform/CrosshairDrawScreen.java} super\.mouseDragged\((\w+|MenuScale\.toMenu\(\w+\)), ((?:MenuScale\.toMenu\()?\w+\)?), ((?:MenuScale\.toMenu\()?\w+\)?)\) => super.mouseDragged(($1).x(), ($1).y(), ($1).button(), $2, $3)

# ---------- GUI drawing (compat/GraphicsBridge): the 2D pose, pipelines, colours, fonts, textures ----------
s-in ** \b(graphics|g|guiGraphics|graphics\(\))\.pose\(\) => $1.pose2d()
replace net.minecraft.client.renderer.RenderPipelines com.flintclient.client.compat.RenderPipelines
replace net.minecraft.util.ARGB com.flintclient.client.compat.ARGB
replace net.minecraft.network.chat.FontDescription com.flintclient.client.compat.FontDescription
# 1.21.1's dynamic textures have no debug label.
s-in ** new DynamicTexture\((?:\(\) -> (?:"[^"]*"|[^,"])+|\w+::toString), => new DynamicTexture(
s-in {platform/Texture.java,control/platform/Mc263Overlay.java} super\((?:\(\) -> \w+|\w+::toString), (\w+)\); => super($1);
# 26.x maps a scissor rectangle through the pose; 1.21.1 takes it as given.
s-in platform/Frame.java graphics\.enableScissor\( => graphics.flintScissor(
# 1.21.1's GUI scale is a double (always a whole number): compat/Bridges.Window.
s-in ** \.getGuiScale\(\) => .guiScaleInt()
s-in platform/AtlasImage.java writeRows\(texture\.getTexture\(\), => writeRows(texture,

# ---------- keys and the mouse ----------
s-in {control/ControlCenter.java,platform/MenuHost.java} \.matches\((event)\) => .matches($1.key(), $1.scancode())
s-in {control/ControlCenter.java,platform/MenuHost.java} \.matchesMouse\((event)\) => .matchesMouse($1.button())
s-in ** InputConstants\.getKey\((event)\) => InputConstants.getKey($1.key(), $1.scancode())
# 1.21.1's key categories are translation keys.
s-in ** (\w+)\.getCategory\(\)\.label\(\)\.getString\(\) => net.minecraft.client.resources.language.I18n.get($1.getCategory())
replace Minecraft.getInstance().hasShiftDown() net.minecraft.client.gui.screens.Screen.hasShiftDown()

# ---------- render states: 1.21.1 draws entities straight from the game; Flint's hooks fill stand-ins (compat/state) ----------
replace net.minecraft.client.renderer.entity.state. com.flintclient.client.compat.state.
replace net.minecraft.client.renderer.state. com.flintclient.client.compat.state.
replace net.minecraft.client.renderer.SubmitNodeCollector com.flintclient.client.compat.state.SubmitNodeCollector
replace net.minecraft.client.renderer.item.ItemModelResolver com.flintclient.client.compat.state.ItemModelResolver
# 1.21.1's PlayerSkin names its texture and model directly.
s-in ** \.body\(\)\.texturePath\(\) => .texture()
s-in ** \bPlayerModelType\.(SLIM|WIDE) => net.minecraft.client.resources.PlayerSkin.Model.$1
s-in ** import net\.minecraft\.world\.entity\.player\.PlayerModelType;\n =>

# ---------- names 1.21.2 to 1.21.9 changed ----------
word getDeltaTracker getTimer
replace net.minecraft.world.entity.player.PlayerSkin net.minecraft.client.resources.PlayerSkin
# authlib 6's GameProfile has getters.
s-in ** (getGameProfile|getProfile|profile)\(\)\.name\(\) => $1().getName()
s-in ** (getGameProfile|getProfile|profile)\(\)\.id\(\) => $1().getId()
replace SharedConstants.getCurrentVersion().name() SharedConstants.getCurrentVersion().getName()
# Level heights: 1.21.2 renamed the build limits (getMaxY is the top block, one under the build height).
s-in {control/platform/ambient/AmbientEnvironment.java,control/platform/Mc263GameData.java,control/platform/Mc263Maps.java,control/platform/Mc263MapScanner.java,control/platform/Mc263World.java,control/platform/sound/SoundLevel.java} \.getMinY\(\) => .getMinBuildHeight()
s-in {control/platform/ambient/AmbientEnvironment.java,control/platform/Mc263GameData.java,control/platform/Mc263World.java} (\w+)\.getMaxY\(\) => ($1.getMaxBuildHeight() - 1)
s-in control/platform/ambient/AmbientEnvironment.java \.getMinSectionY\(\) => .getMinSection()
s-in control/platform/sound/SoundLevel.java public int getMinY\(\) => public int getMinBuildHeight()
# 1.21.1's isSolidRender asks the block's place (it doesn't matter for the blocks asked about).
s-in ** \.isSolidRender\(\) => .isSolidRender(net.minecraft.world.level.EmptyBlockGetter.INSTANCE, net.minecraft.core.BlockPos.ZERO)
s-in ** Direction\.getApproximateNearest\( => Direction.getNearest(
s-in {control/platform/Mc263SoundFilters.java,control/platform/sound/SoundPhysics.java} mainCamera\(\)\.position\(\) => mainCamera().getPosition()
replace SoundSource.UI SoundSource.MASTER
replace Screenshot.takeScreenshot( com.flintclient.client.compat.McCompat.takeScreenshot(
# 1.21.1 keeps item cooldowns per item.
s-in {control/platform/Mc263GameData.java,control/platform/Mc263LookMods.java,control/platform/Mc263Overlay.java} (cooldowns|getCooldowns\(\))\.(isOnCooldown|getCooldownPercent)\((\w+)(\)|, ) => $1.$2($3.getItem()$4
s-in control/platform/Mc263GameData.java cooldowns\.getCooldownGroup\((\w+(?:\[\w+\])?)\) => net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey($1.getItem())
# 1.21.1's key categories are translation keys.
s-in control/platform/ControlKeys.java public static final KeyMapping\.Category CATEGORY = .*; => public static final String CATEGORY = "key.category.flintclient.main";
s-in control/platform/Mc263ControlPlatform.java mapping\.getCategory\(\) == KeyMapping\.Category\.(\w+) => KeyMapping.CATEGORY_$1.equals(mapping.getCategory())

# ---------- modules 1.21.1 can't have: their page says why, and they can't be turned on (compat/ModuleAvailability) ----------
file control/model/ModuleDescriptor.java
# (after the settings are built, so the page keeps every row the catalog names, shown off with the reason). Module
# descriptions are built on Flint's settings thread while Minecraft is still starting (ControlState.readAhead), so what
# this asks touches nothing of Minecraft's: McCompat would, and the two threads could wait on each other for good.
s (\t\tthis\.status = Objects\.requireNonNull\(status\);\n) => \t\tString flint\$unavailable = com.flintclient.client.compat.ModuleAvailability.unavailable(id);\n\t\tif (flint\$unavailable != null) {\n\t\t\tstatus = Status.BLOCKED;\n\t\t\tstatusNote = flint\$unavailable;\n\t\t}\n$1

# ---------- tooltip images: 1.21.1's take no font for their height and no size to draw in ----------
s-in {control/platform/Mc263Food.java,control/platform/Mc263Containers.java} public int getHeight\(Font font\) => public int getHeight()
s-in {control/platform/Mc263Food.java,control/platform/Mc263Containers.java} public void renderImage\(Font font, int (\w+), int (\w+), int \w+, int \w+, GuiGraphics graphics\) => public void renderImage(Font font, int $1, int $2, GuiGraphics graphics)

# ---------- Saturation (AppleSkin): 1.21.1 keeps food on the FOOD component alone, and its F3 screen is fixed ----------
file control/platform/Mc263Food.java
s import com\.flintclient\.client\.mixin\.feature\.DebugScreenEntriesInvoker;\n =>
s import net\.minecraft\.client\.gui\.components\.debug\.\w+;\n =>
s* import net\.minecraft\.client\.gui\.components\.debug\.\w+;\n =>
s import net\.minecraft\.world\.item\.component\.Consumable;\n =>
s import net\.minecraft\.world\.item\.component\.TooltipDisplay;\n =>
s* import net\.minecraft\.world\.item\.consume_effects\.\w+;\n =>
s stack\.has\(DataComponents\.CONSUMABLE\) \? stack\.get\(DataComponents\.FOOD\) : null => stack.get(DataComponents.FOOD)
s (?s)(private static boolean rotten\(ItemStack stack\) \{\n).*?\n\t\}\n => $1\t\treturn com.flintclient.client.compat.FoodEffects.harmful(stack);\n\t}\n
s (?s)\t\tConsumable consumable = stack\.get\(DataComponents\.CONSUMABLE\);\n\t\tif \(consumable != null\) \{.*?\n\t\t\}\n(\t\treturn health;) => \t\thealth += com.flintclient.client.compat.FoodEffects.regeneration(stack);\n$1
s stack\.getOrDefault\(DataComponents\.TOOLTIP_DISPLAY, TooltipDisplay\.DEFAULT\)\.hideTooltip\(\) => stack.has(DataComponents.HIDE_TOOLTIP)
# The food line in F3: 1.21.1's debug screen is a fixed list, so it is added to the game information (mixin.feature.DebugOverlayFoodMixin) whenever the setting isn't Never.
s (?s)\tstatic final class Debug implements DebugScreenEntry \{.*\n\t\}\n\}\n?$ => \tstatic final class Debug {\n\t\tprivate static final DecimalFormat SATURATION = new DecimalFormat("#.##");\n\t\tprivate static final DecimalFormat EXHAUSTION = new DecimalFormat("0.00");\n\t\tprivate static final DecimalFormat EXHAUSTION_MAX = new DecimalFormat("#.##");\n\n\t\tstatic void sync(ModuleState state) {\n\t\t}\n\n\t\t/** The line for the F3 screen's game information, or null. */\n\t\tstatic @Nullable String line() {\n\t\t\tPlayer player = Minecraft.getInstance().player;\n\t\t\tif (player == null || !GUARD.on() || !Mods.on(MODULE) || Mods.state(MODULE).option(Saturation.DEBUG) == 0) {\n\t\t\t\treturn null;\n\t\t\t}\n\t\t\treturn "hunger: " + player.getFoodData().getFoodLevel() + ", sat: " + SATURATION.format(saturation(player)) + ", exh: "\n\t\t\t\t+ EXHAUSTION.format(exhaustion(player)) + "/" + EXHAUSTION_MAX.format(FoodRegen.MAX_EXHAUSTION);\n\t\t}\n\t}\n\n\t/** Saturation's line on the F3 screen, or null. */\n\tpublic static @Nullable String debugLine() {\n\t\treturn Debug.line();\n\t}\n}\n

# ---------- toasts: 1.21.1's ToastComponent asks a toast to draw and say whether it stays in one call ----------
s-in {control/platform/Mc263HintToast.java,control/platform/Mc263NoticeToast.java} toasts\.ToastManager; => toasts.ToastComponent;
s-in {control/platform/Mc263HintToast.java,control/platform/Mc263NoticeToast.java} @Override\n\tpublic Visibility getWantedVisibility\(\) => public Visibility getWantedVisibility()
s-in {control/platform/Mc263HintToast.java,control/platform/Mc263NoticeToast.java} @Override\n\tpublic void update\(ToastManager manager, long visibleMillis\) => public void update(ToastComponent manager, long visibleMillis)
s-in {control/platform/Mc263HintToast.java,control/platform/Mc263NoticeToast.java} public void render\(GuiGraphics graphics, Font font, long visibleMillis\) \{ => public Visibility render(GuiGraphics graphics, ToastComponent manager, long visibleMillis) {\n\t\tupdate(manager, visibleMillis);\n\t\tflint\$render(graphics, manager.getMinecraft().font, visibleMillis);\n\t\treturn getWantedVisibility();\n\t}\n\n\tprivate void flint\$render(GuiGraphics graphics, Font font, long visibleMillis) {

# ---------- items: components 1.21.2 to 1.21.5 added ----------
