s using\.get\(net\.minecraft\.core\.component\.DataComponents\.BLOCKS_ATTACKS\)\.blockDelayTicks\(\) => 5
s using\.get\(net\.minecraft\.core\.component\.DataComponents\.CONSUMABLE\) != null => (using.has(net.minecraft.core.component.DataComponents.FOOD) || using.getUseAnimation() == net.minecraft.world.item.UseAnim.DRINK)

file control/platform/BuiltInResources.java
# 1.21.1 reads pack metadata through serializers; the pack section is the only one asked for.
s (?s)\t\t@Override\n\t\tpublic <T> @Nullable T getMetadataSection\(MetadataSectionType<T> type\) \{.*?\n\t\t\}\n => \t\t@Override\n\t\t@SuppressWarnings("unchecked")\n\t\tpublic <T> @Nullable T getMetadataSection(net.minecraft.server.packs.metadata.MetadataSectionSerializer<T> type) {\n\t\t\tif (type != PackMetadataSection.TYPE) {\n\t\t\t\treturn null;\n\t\t\t}\n\t\t\treturn (T) new PackMetadataSection(Component.literal("Flint Client's built-in assets"), SharedConstants.getCurrentVersion().getPackVersion(PackType.CLIENT_RESOURCES), Optional.empty());\n\t\t}\n

