s (\t+)InventoryScreen\.renderEntityInInventoryFollowsMouse\(graphics, x0, y0, x1, y1, size, 0\.0625F, cx - 26, mouseY, player\); => $1graphics.pose().pushPose();\n$1graphics.pose().setIdentity();\n$1try {\n$1\tInventoryScreen.renderEntityInInventoryFollowsMouse(graphics, x0, y0, x1, y1, size, 0.0625F, cx - 26, mouseY, player);\n$1} finally {\n$1\tgraphics.pose().popPose();\n$1}

