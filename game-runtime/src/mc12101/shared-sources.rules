# names for such a module is off with the reason (the module has no panel look while it can't be on).
s (\t\t\tModuleDescriptor module = ModuleRegistry\.get\(owner\);\n)(\t\t\tif \(!panelLook\(module\)\) \{) => $1\t\t\tif (!module.status().usable()) {\n\t\t\t\treturn new Row(label, kind, null, null, false, false, module.statusNote());\n\t\t\t}\n$2
s (\t\t\t// A module Flint keeps switched off \(it needs another company's permission\) gets no card\.\n\t\t\tif \(!module\.status\(\)\.usable\(\))\) \{ => $1 && module.statusNote() != null && !module.statusNote().equals(com.flintclient.client.compat.McCompat.unavailable(module.id()))) {

