{
  "schemaVersion": 1,
  "id": "flintclient",
  "version": "${version}",
  "name": "Flint Client",
  "description": "Flint Client's in-game runtime for Minecraft 1.8.9: the Right Shift menu and Flint's PvP HUD mods.",
  "authors": [
    "Flint Client Team"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.flintclient.legacy.FlintLegacy"
    ]
  },
  "mixins": [
    {
      "config": "flintclient.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "1.8.9",
    "java": ">=21"
  }
}
