{
  "schemaVersion": 1,
  "id": "flintbench",
  "version": "${version}",
  "name": "Flint Bench Probe",
  "description": "Dev-only benchmark probe: records frame, tick, memory and GC timings and drives a scripted scenario. Inert unless -Dflintbench.out is set.",
  "authors": [
    "Flint Client Team"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.flintclient.bench.FlintBench"
    ]
  },
  "mixins": [
    {
      "config": "flintbench.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
