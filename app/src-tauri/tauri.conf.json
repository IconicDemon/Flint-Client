{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flint Client",
  "version": "../package.json",
  "identifier": "com.flintclient.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flint Client",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0a0908",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A Minecraft: Java Edition launcher.",
    "longDescription": "Flint Client is a lightweight native desktop application for legitimate Minecraft owners.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        },
        "appPosition": {
          "x": 165,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 435,
          "y": 180
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Flint Client",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNDQxMzZERUZFMjFDNDUKUldSRkhPTHZiUk5FN2thL2hpb2tUdlNRbWllZUxwV0lJdWxIRFpMdUtKbEErQTFOT0pCOFVoMk8K",
      "endpoints": [
        "https://github.com/IconicDemon/Flint-Client/releases/download/updater-beta/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
